[Unit]
Description=Consulta de Ativos - Times (porta 8502)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/portal-spare-v2/consulta_times
ExecStart=/opt/portal-spare-v2/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8502 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/portal-spare-v2

[Install]
WantedBy=multi-user.target
