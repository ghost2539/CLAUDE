# Portal SPARE — serviço de USUÁRIO (systemd --user), servidor novo.
#
# Roda com a conta de rede de quem opera o portal; não existe usuário de
# serviço. Reiniciar não pede root:
#     systemctl --user restart portal-spare
#
# Instalar (com a própria conta):
#     mkdir -p ~/.config/systemd/user
#     cp deploy/portal_spare.user.service ~/.config/systemd/user/portal-spare.service
#     systemctl --user daemon-reload
#     systemctl --user enable --now portal-spare.service
#
# Para o portal continuar no ar depois do logout e voltar sozinho no boot, um
# administrador habilita o lingering UMA vez:
#     sudo loginctl enable-linger <sua conta>
# Sem isso o serviço morre ao encerrar a sessão.
#
# Endurecimento: serviço de usuário não aceita ProtectSystem/ProtectHome —
# eles exigem root. Fica o que é possível sem privilégio.

[Unit]
Description=Portal de Operacoes SPARE
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/vcreports/portal-spare

# Configuração e cofre moram DENTRO da pasta do portal: nada é instalado ou
# gravado fora dela.
EnvironmentFile=/var/www/vcreports/portal-spare/data/environment
Environment=PORTAL_COFRE_DIR=/var/www/vcreports/portal-spare/data/cofre

# ExecStart em UMA linha só, de propósito: dentro de uma linha continuada
# com "\", o systemd NÃO trata "#" como comentário — ele vira argumento do
# comando e o serviço não sobe.
#
# Quando o IP do proxy for conhecido, acrescente ao fim da linha abaixo:
#     --proxy-headers --forwarded-allow-ips=<IP do proxy>
# Sem isso a trilha de acessos registra o IP do proxy, não o de quem usou.
ExecStart=/var/www/vcreports/portal-spare/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8901 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=default.target
