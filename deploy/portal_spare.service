[Unit]
# Portal de Operações SPARE — serviço do sistema (servidor novo).
#
# Instalar em /etc/systemd/system/portal-spare.service e:
#   systemctl daemon-reload && systemctl enable --now portal-spare
#
# O portal usa SQLite em data/db/ por padrão; não depende de banco externo.
# Se um dia passar a usar PostgreSQL na mesma máquina, acrescente
# "After=postgresql.service" — NUNCA "Requires=", que impede a subida
# quando o banco está fora e não é o caso hoje.
Description=Portal de Operacoes SPARE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portalspare
Group=portalspare
WorkingDirectory=/var/www/vcreports/portal-spare

# Só configuração aqui. NENHUM segredo: o que for segredo entra pelo
# marcador @cofre:NOME@, ou pelo /run/portal-spare.env logo abaixo, no caso
# do EBS e dos Correios. Permissão 600.
#
# É `data/environment`, dentro da pasta da aplicação. O /etc/portal_operacoes_spare
# era o SERVIDOR ANTIGO (/opt/portal-spare-v2) e não existe aqui — apontar
# para lá não dá erro claro: o serviço sobe sem DATABASE_URL e falha depois,
# longe da causa. Pior, o ReadWritePaths para um caminho inexistente faz o
# systemd recusar o namespace e a unit nem inicia.
EnvironmentFile=/var/www/vcreports/portal-spare/data/environment

# ── AS CREDENCIAIS DO EBS E DOS CORREIOS ────────────────────────────────
# Elas NÃO passam pelo cofre e NÃO ficam no environment acima. Vêm do cofre
# corporativo (/etc/vcreports/.secrets.env, mantido por outro time) e
# chegam ao portal como VARIÁVEL DE AMBIENTE — o código as lê direto do
# os.environ, e é assim que tem de ser.
#
# O ExecStartPre recorta do arquivo do outro time só os prefixos que são
# nossos e escreve em /run/portal-spare.env. O recorte é o ponto: o
# .secrets.env tem segredo de muita gente, e o portal não tem por que
# enxergar o que não é dele.
#
# O `+` faz esta linha rodar com privilégio e fora do sandbox — sem ele,
# ProtectSystem=strict deixa /run somente leitura e o ProtectHome esconde
# o resto; o recorte falharia e o serviço subiria sem credencial nenhuma.
#
# /run é tmpfs: o arquivo nasce a cada start e morre no reboot. Segredo
# recortado não fica em disco.
ExecStartPre=+/bin/sh -c 'umask 027; grep -E "^(CORREIOS_|EBS_|ORACLE_EBS_)" /etc/vcreports/.secrets.env > /run/portal-spare.env; chgrp portalspare /run/portal-spare.env; chmod 640 /run/portal-spare.env'

# O `-` é obrigatório: no PRIMEIRO start o systemd lê os EnvironmentFile de
# cada Exec*, inclusive o do ExecStartPre acima — que é justamente quem
# ainda vai criar o arquivo. Sem o hífen a unit falha antes de gerá-lo.
EnvironmentFile=-/run/portal-spare.env

# PORTAL_COFRE_DIR NÃO É DEFINIDO AQUI, DE PROPÓSITO.
#
# Ele sai do `data/environment` acima, que é o único lugar onde o caminho do
# cofre é decidido — e é para lá que a própria tela de Obsolescência manda
# gravá-lo quando o cofre não responde.
#
# Definir aqui um `Environment=PORTAL_COFRE_DIR=` era pior do que parece: o
# systemd aplica as diretivas NA ORDEM do arquivo, e esta vinha DEPOIS do
# EnvironmentFile. O valor cravado na unit vencia silenciosamente o que
# estivesse configurado no environment — sem erro, sem log, com o portal
# procurando segredo numa pasta vazia e a tela dizendo que não há
# credencial. Um caminho decidido em dois lugares é um caminho que vai
# divergir; quando divergir, quem perde é sempre o que a pessoa editou.
#
# Se algum dia o environment não trouxer a variável, o padrão do código é
# ~/.config/portal-spare — que o ProtectHome=yes abaixo esconde do serviço.
# Por isso a linha tem de existir no environment, não aqui.

ExecStart=/var/www/vcreports/portal-spare/venv/bin/python -m uvicorn main:app \
    --host 0.0.0.0 --port 8901 --workers 1
Restart=on-failure
RestartSec=5

# Segurança de processo
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0027
# Caminhos graváveis: os dados do portal — bancos SQLite, uploads, capturas
# — e o cofre, que o CLI regrava ao definir um segredo.
ReadWritePaths=/var/www/vcreports/portal-spare/data
# O hífen faz o systemd TOLERAR o caminho ausente. Sem ele, uma instalação
# que não tenha essa pasta não ganha um aviso: o systemd recusa montar o
# namespace e a unit simplesmente não inicia. Fica aqui para a instalação
# que ainda guarde o cofre fora da pasta da aplicação.
ReadWritePaths=-/etc/portal_operacoes_spare/cofre

[Install]
WantedBy=multi-user.target
