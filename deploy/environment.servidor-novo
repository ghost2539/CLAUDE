# ============================================================================
#  Portal de Operações SPARE — ambiente do servidor novo.
#
#  Lugar: /var/www/vcreports/portal-spare/data/environment   (permissão 600)
# ============================================================================

# ── Cofre ───────────────────────────────────────────────────────────────
COFRE_CORPORATIVO=sim
# Cofre local dentro da pasta do portal, sob data/ — nada é gravado fora.
PORTAL_COFRE_DIR=/var/www/vcreports/portal-spare/data/cofre

# ── Servidor ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8901
APP_BASE_PATH=/portal-spare
API_BARRA_FINAL=1
CONSULTA_TIMES_PORTA=0
VERIFY_SSL=false

SN_INDIC_REFRESH_MIN=0

HTTPS_PROXY=
SN_PROXY=
SN_API_PROXY=

# ── Banco ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////var/www/vcreports/portal-spare/data/db/portal.db

# ── Sessão e primeiro administrador ─────────────────────────────────────
PORTAL_SESSION_SECRET=@cofre:PORTAL_SESSION_SECRET@
INITIAL_ADMIN_LOGIN=@cofre:INITIAL_ADMIN_LOGIN@
