/* ================================================================
   Module: Identificação (Label printing — Zebra ZPL + Lexmark A4)
   ================================================================ */
window.SPARE_MODULES = window.SPARE_MODULES || {};
window.SPARE_MODULES.identificacao = {

    render: function (container, sub) {
        var S = window.SPARE;
        var TAB_LIST = [
            ['zebra',    'Etiqueta Zebra'],
            ['a4',       'Identificação A4'],
            ['impressoras', 'Impressoras']
        ];
        sub = sub || 'zebra';
        S.tabs(TAB_LIST, sub, 'identificacao');

        var handlers = {
            zebra:       renderZebra,
            a4:          renderA4,
            impressoras: renderPrinters
        };
        (handlers[sub] || renderZebra)(container, S);
    }

};

var _idPrinters = { ZEBRA: [], LEXMARK: [] };
var _idOptions = {};
var _idSelected = {};

/* ── Zebra tab ─────────────────────────────────────────────────── */
function renderZebra(c, S) {
    c.innerHTML =
        '<h1 class="page-title">Etiqueta Zebra</h1>' +
        '<div class="card mb-3">' +
            '<div class="card-header">Configuração da Etiqueta</div>' +
            '<div class="card-body">' +
                '<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">' +
                    '<div><label>Modo</label>' +
                        '<select id="zb-mode" class="form-control">' +
                            '<option value="lot">Gerar Caixa/Lote</option>' +
                            '<option value="free">Livre</option>' +
                        '</select></div>' +
                    '<div><label>Operação</label>' +
                        '<select id="zb-operation" class="form-control">' +
                            '<option value="triagem">Triagem</option>' +
                            '<option value="venda">Venda</option>' +
                            '<option value="livre">Livre</option>' +
                        '</select></div>' +
                    '<div><label>Equipamento</label>' +
                        '<input id="zb-equipment" class="form-control" placeholder="Ex: NOTEBOOK DELL LATITUDE"></div>' +
                    '<div><label>Quantidade</label>' +
                        '<input id="zb-quantity" class="form-control" placeholder="Ex: 10"></div>' +
                    '<div id="zb-lot-group"><label>Lote (venda)</label>' +
                        '<input id="zb-lot" class="form-control" placeholder="Lote de venda"></div>' +
                    '<div><label>Título (livre)</label>' +
                        '<input id="zb-title" class="form-control" placeholder="Título personalizado"></div>' +
                    '<div><label>Caixa (livre)</label>' +
                        '<input id="zb-box" class="form-control" placeholder="Identificador personalizado"></div>' +
                    '<div><label>Cópias</label>' +
                        '<input id="zb-copies" class="form-control" type="number" value="1" min="1" max="100"></div>' +
                    '<div><label>Impressora Zebra</label>' +
                        '<select id="zb-printer" class="form-control">' +
                            '<option value="">Nenhuma (apenas gerar ZPL)</option>' +
                        '</select></div>' +
                    '<div><label>Próxima caixa</label>' +
                        '<div><span id="zb-next" class="badge badge-info" style="font-size:1.1rem;padding:.4rem .8rem">—</span></div></div>' +
                '</div>' +
                '<div style="margin-top:1.5rem;display:flex;gap:.8rem">' +
                    '<button class="btn btn-primary" id="zb-generate">Gerar / Imprimir</button>' +
                    '<button class="btn" id="zb-preview">Preview ZPL</button>' +
                '</div>' +
                '<pre id="zb-result" style="margin-top:1rem;display:none;max-height:300px;overflow:auto;' +
                    'background:var(--bg-input);padding:1rem;border-radius:8px;font-size:.85rem"></pre>' +
            '</div>' +
        '</div>' +
        '<div class="card">' +
            '<div class="card-header">Recebimentos para vincular</div>' +
            '<div class="card-body">' +
                '<div style="display:flex;gap:.8rem;margin-bottom:1rem">' +
                    '<input id="zb-search" class="form-control" placeholder="Buscar recebimento..." style="flex:1">' +
                    '<select id="zb-filter-status" class="form-control" style="width:auto">' +
                        '<option value="">Todos os status</option>' +
                        '<option value="RECEBIDO">Recebido</option>' +
                        '<option value="AG TRIAGEM">Ag. Triagem</option>' +
                        '<option value="EM TRIAGEM">Em Triagem</option>' +
                    '</select>' +
                '</div>' +
                '<div id="zb-receipts-table" style="max-height:400px;overflow:auto"></div>' +
                '<div style="margin-top:.5rem;color:var(--text-secondary)">' +
                    'Selecionados: <strong id="zb-sel-count">0</strong>' +
                '</div>' +
            '</div>' +
        '</div>';

    _idSelected = {};
    _idLoadOptions(S);
    _idLoadPrinters(S);

    var mode = document.getElementById('zb-mode');
    var op = document.getElementById('zb-operation');
    mode.addEventListener('change', function () { _zbUpdateUI(); });
    op.addEventListener('change', function () { _zbUpdateUI(); });
    _zbUpdateUI();

    document.getElementById('zb-generate').addEventListener('click', function () { _zbGenerate(S); });
    document.getElementById('zb-preview').addEventListener('click', function () { _zbPreview(S); });
    document.getElementById('zb-search').addEventListener('input', function () { _zbLoadReceipts(S); });
    document.getElementById('zb-filter-status').addEventListener('change', function () { _zbLoadReceipts(S); });
    _zbLoadReceipts(S);
}

function _zbUpdateUI() {
    var mode = document.getElementById('zb-mode').value;
    var op = document.getElementById('zb-operation').value;
    var lotGroup = document.getElementById('zb-lot-group');
    lotGroup.style.display = (mode === 'lot' && op === 'venda') ? '' : 'none';
    var next = document.getElementById('zb-next');
    if (mode === 'lot') {
        var prefix = op === 'venda' ? 'next_sale' : 'next_triage';
        next.textContent = _idOptions[prefix] || '—';
    } else {
        next.textContent = 'Livre';
    }
}

function _zbLoadReceipts(S) {
    var q = document.getElementById('zb-search').value;
    var status = document.getElementById('zb-filter-status').value;
    var params = new URLSearchParams();
    if (q) params.set('q', q);
    if (status) params.set('status', status);
    S.api('/identificacao/receipts?' + params).then(function (d) {
        var rows = (d.records || []).slice(0, 200);
        var container = document.getElementById('zb-receipts-table');
        if (!rows.length) {
            container.innerHTML = '<div style="padding:1rem;color:var(--text-secondary)">Nenhum recebimento encontrado</div>';
            return;
        }
        var html = '<table class="data-table"><thead><tr><th></th><th>ID</th><th>Ativo</th><th>Descrição</th><th>Status</th><th>Data</th></tr></thead><tbody>';
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            var checked = _idSelected[r.id] ? 'checked' : '';
            html += '<tr>' +
                '<td><input type="checkbox" class="zb-chk" data-id="' + r.id + '" ' + checked + '></td>' +
                '<td>' + r.id + '</td>' +
                '<td>' + S.esc(r.asset_display) + '</td>' +
                '<td>' + S.esc(r.description_display) + '</td>' +
                '<td>' + S.badge(r.status || '') + '</td>' +
                '<td>' + S.esc(r.date_display) + '</td>' +
            '</tr>';
        }
        html += '</tbody></table>';
        container.innerHTML = html;
        var checks = container.querySelectorAll('.zb-chk');
        for (var j = 0; j < checks.length; j++) {
            checks[j].addEventListener('change', function () {
                var id = parseInt(this.dataset.id);
                if (this.checked) _idSelected[id] = true;
                else delete _idSelected[id];
                document.getElementById('zb-sel-count').textContent = Object.keys(_idSelected).length;
            });
        }
    }).catch(function () {});
}

function _zbBody() {
    return {
        mode: document.getElementById('zb-mode').value,
        operation: document.getElementById('zb-operation').value,
        quantity: document.getElementById('zb-quantity').value,
        equipment: document.getElementById('zb-equipment').value,
        copies: parseInt(document.getElementById('zb-copies').value) || 1,
        lot: document.getElementById('zb-lot').value || null,
        box: document.getElementById('zb-box').value || null,
        title: document.getElementById('zb-title').value || null,
        receipt_ids: Object.keys(_idSelected).map(Number)
    };
}

function _zbPrinterFields(body) {
    var printer = document.getElementById('zb-printer').value;
    if (printer) {
        var parts = printer.split(':');
        body.printer_ip = parts[0];
        body.printer_port = parseInt(parts[1]);
    }
    return body;
}

function _zbGenerate(S) {
    var body = _zbPrinterFields(_zbBody());
    var endpoint = body.mode === 'lot' ? '/identificacao/generate-box' : '/identificacao/print-free';
    S.api(endpoint, { method: 'POST', body: body }).then(function (d) {
        S.toast((d.status || 'OK') + ' — ' + (d.box || 'OK'), 'success');
        var pre = document.getElementById('zb-result');
        pre.style.display = 'block';
        pre.textContent = d.zpl || JSON.stringify(d, null, 2);
        _idSelected = {};
        document.getElementById('zb-sel-count').textContent = '0';
        _idLoadOptions(S);
        _zbUpdateUI();
        _zbLoadReceipts(S);
    }).catch(function (e) { S.toast(e.message, 'error'); });
}

function _zbPreview(S) {
    var body = _zbBody();
    fetch('/api/identificacao/preview-zpl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body)
    }).then(function (r) { return r.text(); }).then(function (text) {
        var pre = document.getElementById('zb-result');
        pre.style.display = 'block';
        pre.textContent = text;
    }).catch(function (e) { S.toast(e.message, 'error'); });
}


/* ── A4 tab ────────────────────────────────────────────────────── */
function renderA4(c, S) {
    c.innerHTML =
        '<h1 class="page-title">Identificação A4 — Lexmark</h1>' +
        '<div class="card">' +
            '<div class="card-header">Dados da Identificação</div>' +
            '<div class="card-body">' +
                '<div style="display:grid;grid-template-columns:1fr;gap:1rem">' +
                    '<div><label>Texto 1 (linha principal)</label>' +
                        '<input id="a4-text1" class="form-control" placeholder="Ex: TRIAGEM"></div>' +
                    '<div><label>Texto 2</label>' +
                        '<input id="a4-text2" class="form-control" placeholder="Ex: NOTEBOOKS"></div>' +
                    '<div><label>Texto 3</label>' +
                        '<input id="a4-text3" class="form-control" placeholder="Ex: LOTE 001"></div>' +
                    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">' +
                        '<div><label>Cópias</label>' +
                            '<input id="a4-copies" class="form-control" type="number" value="1" min="1" max="100"></div>' +
                        '<div><label>Impressora Lexmark</label>' +
                            '<select id="a4-printer" class="form-control">' +
                                '<option value="">Nenhuma (gerar PDF)</option>' +
                            '</select></div>' +
                    '</div>' +
                '</div>' +
                '<div style="margin-top:1.5rem;display:flex;gap:.8rem">' +
                    '<button class="btn btn-primary" id="a4-generate">Gerar PDF</button>' +
                    '<button class="btn" id="a4-print">Enviar para Lexmark</button>' +
                '</div>' +
            '</div>' +
        '</div>';

    _idLoadPrinters(S);
    document.getElementById('a4-generate').addEventListener('click', function () { _a4Generate(S); });
    document.getElementById('a4-print').addEventListener('click', function () { _a4Print(S); });
}

function _a4Body() {
    return {
        text1: document.getElementById('a4-text1').value,
        text2: document.getElementById('a4-text2').value,
        text3: document.getElementById('a4-text3').value,
        copies: parseInt(document.getElementById('a4-copies').value) || 1
    };
}

function _a4Generate(S) {
    var body = _a4Body();
    fetch('/api/identificacao/a4.pdf', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body)
    }).then(function (r) {
        if (!r.ok) return r.json().then(function (d) { throw new Error(d.detail || 'Erro'); });
        return r.blob();
    }).then(function (blob) {
        var url = URL.createObjectURL(blob);
        window.open(url, '_blank');
        S.toast('PDF gerado', 'success');
    }).catch(function (e) { S.toast(e.message, 'error'); });
}

function _a4Print(S) {
    var body = _a4Body();
    var printer = document.getElementById('a4-printer').value;
    if (!printer) { S.toast('Selecione uma impressora Lexmark', 'warning'); return; }
    var parts = printer.split(':');
    body.printer_ip = parts[0];
    body.printer_port = parseInt(parts[1]);
    S.api('/identificacao/a4.print', { method: 'POST', body: body }).then(function (d) {
        S.toast(d.message, 'success');
    }).catch(function (e) { S.toast(e.message, 'error'); });
}


/* ── Printers tab ──────────────────────────────────────────────── */
function renderPrinters(c, S) {
    c.innerHTML =
        '<h1 class="page-title">Impressoras</h1>' +
        '<div class="card mb-3">' +
            '<div class="card-header">Impressoras Cadastradas</div>' +
            '<div class="card-body" id="printers-list"></div>' +
        '</div>' +
        '<div class="card">' +
            '<div class="card-header">Adicionar Impressora</div>' +
            '<div class="card-body">' +
                '<div style="display:grid;grid-template-columns:2fr 1fr 2fr 1fr auto;gap:.8rem;align-items:end">' +
                    '<div><label>Nome</label><input id="pr-name" class="form-control" placeholder="Zebra Triagem"></div>' +
                    '<div><label>Tipo</label>' +
                        '<select id="pr-type" class="form-control">' +
                            '<option value="ZEBRA">Zebra</option>' +
                            '<option value="LEXMARK">Lexmark</option>' +
                        '</select></div>' +
                    '<div><label>IP</label><input id="pr-ip" class="form-control" placeholder="192.168.1.100"></div>' +
                    '<div><label>Porta</label><input id="pr-port" class="form-control" type="number" value="9100"></div>' +
                    '<button class="btn btn-primary" id="pr-save">Salvar</button>' +
                '</div>' +
            '</div>' +
        '</div>';

    _idLoadPrinters(S);
    document.getElementById('pr-save').addEventListener('click', function () {
        var body = {
            name: document.getElementById('pr-name').value,
            printer_type: document.getElementById('pr-type').value,
            ip: document.getElementById('pr-ip').value,
            port: parseInt(document.getElementById('pr-port').value) || 9100
        };
        S.api('/identificacao/printers', { method: 'POST', body: body }).then(function () {
            S.toast('Impressora salva', 'success');
            document.getElementById('pr-name').value = '';
            document.getElementById('pr-ip').value = '';
            _idLoadPrinters(S);
        }).catch(function (e) { S.toast(e.message, 'error'); });
    });
}


/* ── Shared data loading ───────────────────────────────────────── */
function _idLoadOptions(S) {
    S.api('/identificacao/options').then(function (d) {
        _idOptions = d;
        _zbUpdateUI();
    }).catch(function () {});
}

function _idLoadPrinters(S) {
    S.api('/identificacao/printers').then(function (d) {
        _idPrinters = { ZEBRA: [], LEXMARK: [] };
        var list = d.printers || [];
        for (var i = 0; i < list.length; i++) {
            var p = list[i];
            if (_idPrinters[p.printer_type]) _idPrinters[p.printer_type].push(p);
        }
        var zbSel = document.getElementById('zb-printer');
        if (zbSel) {
            zbSel.innerHTML = '<option value="">Nenhuma (apenas gerar ZPL)</option>';
            for (var j = 0; j < _idPrinters.ZEBRA.length; j++) {
                var z = _idPrinters.ZEBRA[j];
                zbSel.innerHTML += '<option value="' + z.ip + ':' + z.port + '">' + S.esc(z.name) + ' (' + z.ip + ')</option>';
            }
        }
        var a4Sel = document.getElementById('a4-printer');
        if (a4Sel) {
            a4Sel.innerHTML = '<option value="">Nenhuma (gerar PDF)</option>';
            for (var k = 0; k < _idPrinters.LEXMARK.length; k++) {
                var l = _idPrinters.LEXMARK[k];
                a4Sel.innerHTML += '<option value="' + l.ip + ':' + l.port + '">' + S.esc(l.name) + ' (' + l.ip + ')</option>';
            }
        }
        var listEl = document.getElementById('printers-list');
        if (listEl) {
            var all = _idPrinters.ZEBRA.concat(_idPrinters.LEXMARK);
            if (!all.length) {
                listEl.innerHTML = '<div style="padding:1rem;color:var(--text-secondary)">Nenhuma impressora cadastrada</div>';
            } else {
                var html = '<table class="data-table"><thead><tr><th>Nome</th><th>Tipo</th><th>IP</th><th>Porta</th></tr></thead><tbody>';
                for (var m = 0; m < all.length; m++) {
                    var pr = all[m];
                    html += '<tr><td>' + S.esc(pr.name) + '</td><td><span class="badge">' + pr.printer_type + '</span></td><td>' + pr.ip + '</td><td>' + pr.port + '</td></tr>';
                }
                html += '</tbody></table>';
                listEl.innerHTML = html;
            }
        }
    }).catch(function () {});
}
