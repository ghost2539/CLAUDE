# Portal de Operações SPARE — variáveis de ambiente
# Copie para .env e preencha os valores reais antes de iniciar.

# ── Banco de dados ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://portal_spare_app:ALTERAR_SENHA@127.0.0.1:5432/portal_operacoes_spare_db
# Banco separado do módulo Controle de Orçamento (/tv2).
# Padrão: arquivo SQLite em data/controle_orcamento.db. Para um Postgres dedicado:
# CONTROLE_ORCAMENTO_DATABASE_URL=postgresql+psycopg://usuario:senha@127.0.0.1:5432/controle_orcamento_db

# ── Sessão / segurança ─────────────────────────────────────────
PORTAL_SESSION_SECRET=ALTERAR_POR_SEGREDO_ALEATORIO_64_CHARS
SESSION_TTL_MINUTES=480

# ── EBS (integração com ERP) ────────────────────────────────────
EBS_LOGIN_URL=https://suporte.example.com/ebs/api/auth/login
EBS_SEARCH_URL=https://suporte.example.com/ebs/api/estoque/busca-imobilizado
VERIFY_SSL=false
TIMEOUT_SECONDS=15
MAX_WORKERS=40

# ── Credenciais protegidas EBS (lidas de arquivo, não de env) ──
CREDENTIALS_DIRECTORY=/etc/portal_operacoes_spare/credentials

# ── Servidor ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8901
WORKERS=1

# ── Aplicação ───────────────────────────────────────────────────
DEFAULT_VALOR_HORA=150.00
INITIAL_ADMIN_LOGIN=ALTERAR_LOGIN_ADMIN
INITIAL_ADMIN_PASSWORD=
UPLOAD_MAX_MB=50
BACKUP_RETENTION_DAYS=30

# ── Rate limiting ───────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=120/minute

# ── HTTPS (opcional — se tiver certificado) ─────────────────────
SSL_CERTFILE=
SSL_KEYFILE=

# ── API dos Correios (rastreio) ─────────────────────────────────
# Cartões de postagem separados por vírgula.
CORREIOS_USUARIO=
CORREIOS_CHAVE=
CORREIOS_CARTOES=
CORREIOS_DR=64
# Opcional: se preenchido, tenta elevar o token tambem via contrato.
CORREIOS_CONTRATO=

# ── Alertas por e-mail (SMTP) ───────────────────────────────────
# Apenas valores PADRÃO. A configuração efetiva fica em
# Parâmetros → Acessos & Alertas (banco de monitoramento).
# A senha nunca vai no código: use o cofre (chave SMTP_SENHA) ou
# grave pela tela (fica cifrada no banco).
SMTP_HOST=
SMTP_PORT=25
SMTP_SEGURANCA=none
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=portal-spare@lojasrenner.com.br
ALERTA_EMAIL_TO=raphael.steilein@lojasrenner.com.br
