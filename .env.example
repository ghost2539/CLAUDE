# Portal de Operações SPARE — variáveis de ambiente
# Copie para .env e preencha os valores reais antes de iniciar.

# ── Banco de dados ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://portal_spare_app:ALTERAR_SENHA@127.0.0.1:5432/portal_operacoes_spare_db
# Banco separado do módulo Controle de Orçamento (/tv2).
# Padrão: arquivo SQLite em data/controle_orcamento.db. Para um Postgres dedicado:
# CONTROLE_ORCAMENTO_DATABASE_URL=postgresql+psycopg://usuario:senha@127.0.0.1:5432/controle_orcamento_db
# Bancos isolados dos módulos novos. O padrão de todos é um arquivo SQLite
# em data/db/<nome>.db — só declare se quiser outro lugar ou outro motor.
# CAPEX_SPARE_DATABASE_URL=
# AGENDAMENTOS_FORN_DATABASE_URL=
# INTERNALIZACAO_DATABASE_URL=

# ── Sessão / segurança ─────────────────────────────────────────
PORTAL_SESSION_SECRET=ALTERAR_POR_SEGREDO_ALEATORIO_64_CHARS
# Ociosidade: a sessão cai depois deste tempo SEM uso — cada pedido do
# usuário reinicia a contagem. Antes o prazo corria desde o login e
# derrubava quem estava no meio do trabalho.
SESSION_TTL_MINUTES=480
# Teto absoluto: por mais que se use, a sessão não passa disto.
SESSION_MAX_HOURS=24
# Cookie de sessão só em HTTPS: auto (liga quando o pedido chega por https,
# direto ou por X-Forwarded-Proto de um proxy confiável) | true | false
SESSION_COOKIE_SECURE=auto
# Proxies reversos cujos X-Forwarded-For / X-Forwarded-Proto valem
# (IPs ou redes, separados por vírgula). Atrás do nginx na mesma máquina,
# o padrão serve; em outra máquina, coloque o IP dela aqui.
TRUSTED_PROXIES=127.0.0.1,::1

# ── TLS de saída (OAM/ServiceNow, EBS, MDM, Correios) ──────────
# Verificação de certificado LIGADA por padrão. Com proxy corporativo que
# intercepta o TLS, aponte a cadeia (CA corporativa + CA do proxy, PEM):
# PORTAL_CA_BUNDLE=/etc/pki/tls/certs/ca-corporativa.pem
# VERIFY_SSL=false desliga tudo — só para diagnóstico, e fica em log.
VERIFY_SSL=true
# CA própria só para o console do MDM (em branco: segue PORTAL_CA_BUNDLE)
# MDM_CA_BUNDLE=/etc/pki/tls/certs/ca-corporativa.pem

# ── EBS (integração com ERP) ────────────────────────────────────
EBS_LOGIN_URL=https://suporte.example.com/ebs/api/auth/login
EBS_SEARCH_URL=https://suporte.example.com/ebs/api/estoque/busca-imobilizado
TIMEOUT_SECONDS=15
MAX_WORKERS=40
# Token de API da conversão EBS → ServiceNow (/api/public-assets, cabeçalho
# X-Api-Key). Prefira o cofre: python3 scripts/cofre.py definir PUBLIC_ASSETS_TOKEN
# PUBLIC_ASSETS_TOKEN=

# ── Credenciais protegidas EBS (lidas de arquivo, não de env) ──
CREDENTIALS_DIRECTORY=/etc/portal_operacoes_spare/credentials

# ── Servidor ────────────────────────────────────────────────────
# producao | testes (testes: e-mails de alerta desligados)
AMBIENTE=producao
# Atrás de proxy HTTPS (deploy/nginx-portal-spare.conf.example): HOST=127.0.0.1
HOST=0.0.0.0
PORT=8901
# Prefixo quando o portal é publicado num subcaminho do proxy (ex.:
# suporte.lojasrenner.com.br/portal-spare). Vazio = raiz do domínio. Quem
# já sobe o uvicorn com --root-path não precisa desta linha.
APP_BASE_PATH=
# Contorno para proxy que acrescenta barra no fim por redirecionamento 301
# (o POST do login viraria GET). 1 liga; vazio mantém o comportamento normal.
API_BARRA_FINAL=
WORKERS=1

# ── Aplicação ───────────────────────────────────────────────────
DEFAULT_VALOR_HORA=150.00
INITIAL_ADMIN_LOGIN=ALTERAR_LOGIN_ADMIN
# Login de rede do admin geral (ícone do portal). Em branco, usa o INITIAL_ADMIN_LOGIN.
ADMIN_GERAL_LOGIN=
UPLOAD_MAX_MB=50
BACKUP_RETENTION_DAYS=30

# ── Rate limiting ───────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=120/minute

# ── HTTPS (opcional — se tiver certificado) ─────────────────────
SSL_CERTFILE=
SSL_KEYFILE=

# ── API dos Correios (rastreio) ─────────────────────────────────
# Cartões de postagem separados por vírgula.
CORREIOS_USUARIO=
CORREIOS_CHAVE=
CORREIOS_CARTOES=
CORREIOS_DR=64
# Opcional: se preenchido, tenta elevar o token tambem via contrato.
CORREIOS_CONTRATO=

# ── Gestão de Compras (PO e projetos do EBS, por HTTP) ──────────
# O portal é CLIENTE do módulo /gestao_compras (Apache), que é quem tem a
# credencial do EBS. Tudo tem padrão no código; só preencha para mudar.
# A credencial NÃO vem daqui: grave GESTAO_COMPRAS_USER e
# GESTAO_COMPRAS_PASS no cofre (scripts/cofre.py definir NOME).
# GESTAO_COMPRAS_URL=https://suporte.lojasrenner.com.br/gestao_compras/
# GESTAO_COMPRAS_TIMEOUT=90
# TLS: vazio segue o VERIFY_SSL do portal. Proxy que intercepta o TLS se
# resolve com PORTAL_CA_BUNDLE — nunca desligando a conferência.
# GESTAO_COMPRAS_VERIFY=
# Proxy de saída. ATENÇÃO: declarar a variável VAZIA é uma decisão ("aqui
# não tem proxy") e encerra a busca; só a ausência total faz o portal
# procurar no HTTPS_PROXY do ambiente.
# GESTAO_COMPRAS_PROXY=

# ── Cofre de segredos ───────────────────────────────────────────
# Ordem de busca de todo segredo: cofre corporativo, cofre local cifrado,
# variável de ambiente. Desligar o corporativo é decisão explícita.
COFRE_CORPORATIVO=sim
# Onde fica o cofre local (cifrado). Fora da pasta do repositório.
# PORTAL_COFRE_DIR=
# Arquivo e módulo do cofre corporativo, quando não estiverem no padrão.
# VCREPORTS_SECRETS_FILE=/etc/vcreports/.secrets.env
# VCREPORTS_SECRETS_MODULE=/usr/local/lib/vcreports/vcreports_secrets.py

# ── Alertas por e-mail (SMTP) ───────────────────────────────────
# Apenas valores PADRÃO. A configuração efetiva fica em
# Parâmetros → Acessos & Alertas (banco de monitoramento).
# A senha nunca vai no código: use o cofre (chave SMTP_SENHA) ou
# grave pela tela (fica cifrada no banco).
SMTP_HOST=
SMTP_PORT=25
SMTP_SEGURANCA=none
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=portal-spare@lojasrenner.com.br
ALERTA_EMAIL_TO=
